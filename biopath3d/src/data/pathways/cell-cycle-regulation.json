          "g1s"
        ],
        [
          "cyce",
          "g1s"
        ]
      ]
    },
    {
      "title": "4 · S phase",
      "text": "Cyclin A–CDK2 promotes DNA replication and prevents re-licensing of origins.",
      "nodes": [
        "e2f",
        "cyca",
        "s"
      ],
      "edges": [
        [
          "e2f",
          "cyca"
        ],
        [
          "cyca",
          "s"
        ]
      ]
    },
    {
      "title": "5 · G2/M switch",
      "text": "Cyclin B–CDK1 accumulates but is held inactive by WEE1 phosphorylation. CDC25 removes this phosphate; active CDK1 activates more CDC25 (positive feedback), producing an abrupt entry into mitosis.",
      "nodes": [
        "cycb",
        "wee1",
        "cdc25",
        "m"
      ],
      "edges": [
        [
          "wee1",
          "cycb"
        ],
        [
          "cdc25",
          "cycb"
        ],
        [
          "cycb",
          "cdc25"
        ],
        [
          "cycb",
          "m"
        ]
      ]
    },
    {
      "title": "6 · Mitotic exit",
      "text": "Once the spindle checkpoint is satisfied, APC/C–Cdc20 ubiquitinates cyclin B and securin. Cyclin B destruction inactivates CDK1, allowing mitotic exit.",
      "nodes": [
        "cycb",
        "apc"
      ],
      "edges": [
