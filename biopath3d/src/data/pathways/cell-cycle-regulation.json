{
  "id": "cell-cycle-regulation",
  "name": "Cell-cycle regulation: cyclin–CDK network",
  "category": "regulation",
  "topic": "molecular-biology",
  "summary": "Sequential waves of cyclin–CDK activity drive the cell through G1, S, G2 and M. Mitogens induce cyclin D; cyclin D–CDK4/6 and cyclin E–CDK2 phosphorylate RB to release E2F; cyclin A–CDK2 runs S phase; cyclin B–CDK1 triggers mitosis; APC/C destroys cyclin B to exit mitosis.",
  "evidence": "established",
  "layout": "manual",
  "clinical": "CDK4/6 inhibitors (palbociclib, ribociclib, abemaciclib) treat HR+/HER2− breast cancer and require functional RB. p16 (CDKN2A) loss and cyclin D1 amplification are common in cancer.",
  "outcomes": [
    "Orderly progression through G1 → S → G2 → M"
  ],
