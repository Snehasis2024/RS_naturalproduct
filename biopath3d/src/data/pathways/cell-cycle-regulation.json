  "steps": [
    {
      "title": "1 · Mitogens → cyclin D",
      "text": "Growth-factor signalling (RAS–ERK, PI3K) induces cyclin D, which binds CDK4/6. INK4 proteins such as p16 block this complex.",
      "nodes": [
        "mitogen",
        "cycd",
        "p16"
      ],
      "edges": [
        [
          "mitogen",
          "cycd"
        ],
        [
          "p16",
          "cycd"
        ]
      ]
    },
    {
      "title": "2 · RB phosphorylation releases E2F",
      "text": "Cyclin D–CDK4/6 begins phosphorylating RB. Partially phosphorylated RB still restrains E2F.",
      "nodes": [
        "cycd",
        "rb",
        "e2f"
      ],
      "edges": [
        [
          "cycd",
          "rb"
        ],
        [
          "rb",
          "e2f"
        ]
      ]
    },
    {
      "title": "3 · The restriction-point switch",
      "text": "E2F induces cyclin E; cyclin E–CDK2 hyperphosphorylates RB, freeing more E2F — a positive-feedback loop that makes G1→S commitment switch-like and mitogen-independent.",
      "nodes": [
        "e2f",
        "cyce",
        "rb",
        "g1s"
      ],
      "edges": [
        [
          "e2f",
          "cyce"
