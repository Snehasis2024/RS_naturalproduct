  "steps": [
    {"title": "1 · PI3K makes PIP₃", "text": "Activated receptors recruit class IA PI3K, which phosphorylates the membrane lipid PIP₂ at the 3′ position to make PIP₃. PTEN reverses this reaction.", "nodes": ["rtk", "pi3k", "pip3", "pten"], "edges": [["rtk", "pi3k"], ["pi3k", "pip3"], ["pten", "pip3"]]},
    {"title": "2 · AKT activation", "text": "AKT and PDK1 bind PIP₃ through PH domains. PDK1 phosphorylates AKT Thr308 (mTORC2 phosphorylates Ser473 for full activity; not shown).", "nodes": ["pip3", "pdk1", "akt"], "edges": [["pip3", "pdk1"], ["pip3", "akt"], ["pdk1", "akt"]]},
    {"title": "3 · Double negative to mTORC1", "text": "AKT phosphorylates and inhibits TSC2. TSC normally inactivates RHEB, so inhibiting TSC lets RHEB-GTP accumulate and activate mTORC1 (an inhibition of an inhibitor = activation).", "nodes": ["akt", "tsc", "rheb", "mtorc1"], "edges": [["akt", "tsc"], ["tsc", "rheb"], ["rheb", "mtorc1"]]},
    {"title": "4 · Growth output", "text": "mTORC1 phosphorylates S6K (activating it) and 4E-BP1 (inactivating it, freeing eIF4E), increasing cap-dependent translation and cell growth.", "nodes": ["mtorc1", "s6k", "4ebp1", "growth"], "edges": [["mtorc1", "s6k"], ["mtorc1", "4ebp1"], ["s6k", "growth"], ["4ebp1", "growth"]]},
    {"title": "5 · Survival", "text": "AKT phosphorylates the pro-apoptotic BH3-only protein BAD, sequestering it and promoting survival (see Apoptosis).", "nodes": ["akt", "bad", "survival"], "edges": [["akt", "bad"], ["bad", "survival"]]}
  ]
}
