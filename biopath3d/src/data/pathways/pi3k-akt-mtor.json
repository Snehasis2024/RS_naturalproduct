{
  "id": "pi3k-akt-mtor",
  "name": "PI3K–AKT–mTOR",
  "category": "signaling",
  "topic": "signaling",
  "summary": "Growth-factor receptors activate PI3K, which produces PIP₃ to recruit and activate AKT. AKT promotes survival and activates mTORC1, the master regulator of cell growth (protein, lipid and nucleotide synthesis).",
  "evidence": "established",
  "layout": "layered",
  "location": "Plasma membrane → cytoplasm → lysosome surface",
  "clinical": "PIK3CA mutations and PTEN loss are among the most common oncogenic events. Drugs: alpelisib (PI3Kα), capivasertib (AKT), everolimus (mTORC1).",
  "outcomes": ["Cell growth", "Survival", "Glucose uptake"],
