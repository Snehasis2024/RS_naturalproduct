{
  "id": "oxphos",
  "name": "Oxidative phosphorylation",
  "category": "metabolic",
  "topic": "metabolism",
  "summary": "Electrons from NADH and FADH₂ flow through the respiratory chain to O₂. Complexes I, III and IV pump protons into the intermembrane space; ATP synthase lets them flow back and uses that energy to make ATP (chemiosmotic coupling).",
  "evidence": "established",
  "layout": "manual",
  "location": "Inner mitochondrial membrane",
  "net": "NADH + H⁺ + ½ O₂ + ~2.5 ADP + ~2.5 Pᵢ → NAD⁺ + H₂O + ~2.5 ATP (≈1.5 ATP per FADH₂)",
  "clinical": "Cyanide and carbon monoxide inhibit complex IV; rotenone inhibits complex I; oligomycin inhibits ATP synthase; uncouplers (2,4-dinitrophenol, thermogenin/UCP1 in brown fat) dissipate the gradient as heat.",
  "references": [
    {
      "label": "KEGG hsa00190 (Oxidative phosphorylation)",
      "url": "https://www.kegg.jp/pathway/hsa00190"
    },
    {
